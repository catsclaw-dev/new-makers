DJANGO_SECRET_KEY=change-me-strong-production-secret-key
DJANGO_DEBUG=False
DJANGO_SERVE_MEDIA=False
DJANGO_ALLOWED_HOSTS=your-domain.ru,www.your-domain.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.ru,https://www.your-domain.ru
DJANGO_SITE_ID=1

DATABASE_URL=sqlite:///db.sqlite3
DOCKER_DATABASE_URL=sqlite:////app/data/db.sqlite3

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
SITE_URL=https://your-domain.ru
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-user
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=New-Makers <noreply@your-domain.ru>
EMAIL_NOTIFICATIONS_ENABLED=True

RABBITMQ_DEFAULT_USER=change-me-rabbitmq-user
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq-password

CELERY_BROKER_URL=amqp://change-me-rabbitmq-user:change-me-rabbitmq-password@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/0
CACHE_URL=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=False
INVITATION_EXPIRE_DAYS=14

GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

GITHUB_OAUTH_CLIENT_ID=your-github-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-github-client-secret

SENTRY_DSN=your-sentry-dsn
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=False
SENTRY_RELEASE=

DJANGO_SILK_ENABLED=False
DJANGO_SILK_AUTHENTICATION=True
DJANGO_SILK_AUTHORISATION=True
DJANGO_SILK_PYTHON_PROFILER=False

DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_HTTPONLY=False
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
