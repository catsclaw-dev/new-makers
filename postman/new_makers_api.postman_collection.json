{
  "info": {
    "name": "New-Makers API",
    "_postman_id": "1f5f3ce0-8a43-4d98-9ec6-1b983c5cfd70",
    "description": "Requests for testing New-Makers DRF API by public, specialist, project owner, and admin roles.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "owner_username",
      "value": "owner1"
    },
    {
      "key": "owner_password",
      "value": "password"
    },
    {
      "key": "specialist_username",
      "value": "specialist1"
    },
    {
      "key": "specialist_password",
      "value": "password"
    },
    {
      "key": "admin_username",
      "value": "admin"
    },
    {
      "key": "admin_password",
      "value": "password"
    },
    {
      "key": "project_id",
      "value": "1"
    },
    {
      "key": "vacancy_id",
      "value": "1"
    },
    {
      "key": "specialist_id",
      "value": "1"
    },
    {
      "key": "application_id",
      "value": "1"
    },
    {
      "key": "invitation_id",
      "value": "1"
    },
    {
      "key": "favorite_id",
      "value": "1"
    },
    {
      "key": "role_id",
      "value": "1"
    },
    {
      "key": "technology_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Public",
      "item": [
        {
          "name": "List published projects",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{base_url}}/projects/"
          }
        },
        {
          "name": "Filter projects by technology and open vacancies",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{base_url}}/projects/?technology=django&has_open_vacancies=true"
          }
        },
        {
          "name": "Retrieve project",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{base_url}}/projects/{{project_id}}/"
          }
        },
        {
          "name": "List specialists",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{base_url}}/specialists/?technology=django&is_available=true"
          }
        },
        {
          "name": "List open vacancies",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{base_url}}/vacancies/?is_open=true"
          }
        }
      ]
    },
    {
      "name": "Specialist",
      "auth": {
        "type": "basic",
        "basic": [
          {
            "key": "username",
            "value": "{{specialist_username}}",
            "type": "string"
          },
          {
            "key": "password",
            "value": "{{specialist_password}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Get my specialist profile",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/specialists/me/"
          }
        },
        {
          "name": "Update my specialist profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"open\",\n  \"bio\": \"Backend developer interested in early-stage product teams.\",\n  \"experience_years\": 3,\n  \"weekly_hours\": 12\n}"
            },
            "url": "{{base_url}}/specialists/me/"
          }
        },
        {
          "name": "Create application",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vacancy\": {{vacancy_id}},\n  \"message\": \"I want to join the project and can help with backend tasks.\"\n}"
            },
            "url": "{{base_url}}/applications/"
          }
        },
        {
          "name": "List my applications",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/applications/"
          }
        },
        {
          "name": "Toggle favorite project",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/projects/{{project_id}}/favorite/"
          }
        },
        {
          "name": "List favorite projects",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/favorites/"
          }
        },
        {
          "name": "Accept invitation",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/invitations/{{invitation_id}}/accept/"
          }
        },
        {
          "name": "Decline invitation",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/invitations/{{invitation_id}}/decline/"
          }
        }
      ]
    },
    {
      "name": "Project Owner",
      "auth": {
        "type": "basic",
        "basic": [
          {
            "key": "username",
            "value": "{{owner_username}}",
            "type": "string"
          },
          {
            "key": "password",
            "value": "{{owner_password}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Create draft project",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"API Team Builder\",\n  \"short_description\": \"Service for forming project teams.\",\n  \"description\": \"Detailed project description for API testing.\",\n  \"goal\": \"Build an MVP with a small team.\",\n  \"stage\": \"mvp\",\n  \"participation_format\": \"mixed\",\n  \"technology_ids\": [{{technology_id}}]\n}"
            },
            "url": "{{base_url}}/projects/"
          }
        },
        {
          "name": "Create vacancy for project",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": {{role_id}},\n  \"title\": \"Backend developer\",\n  \"description\": \"Build API endpoints and domain logic.\",\n  \"required_level\": \"junior\",\n  \"required_count\": 2\n}"
            },
            "url": "{{base_url}}/projects/{{project_id}}/vacancies/"
          }
        },
        {
          "name": "Submit project for moderation",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/projects/{{project_id}}/submit_for_moderation/"
          }
        },
        {
          "name": "Invite specialist",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vacancy\": {{vacancy_id}},\n  \"specialist\": {{specialist_id}},\n  \"message\": \"We would like to invite you to the team.\"\n}"
            },
            "url": "{{base_url}}/invitations/"
          }
        },
        {
          "name": "List incoming applications",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/applications/?status=pending"
          }
        },
        {
          "name": "Accept application",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/applications/{{application_id}}/accept/"
          }
        },
        {
          "name": "Reject application",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/applications/{{application_id}}/reject/"
          }
        },
        {
          "name": "Close project",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/projects/{{project_id}}/close/"
          }
        },
        {
          "name": "Archive project",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"confirmation_title\": \"API Team Builder\"\n}"
            },
            "url": "{{base_url}}/projects/{{project_id}}/archive/"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "auth": {
        "type": "basic",
        "basic": [
          {
            "key": "username",
            "value": "{{admin_username}}",
            "type": "string"
          },
          {
            "key": "password",
            "value": "{{admin_password}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Create role",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"API Developer\",\n  \"slug\": \"api-developer\",\n  \"description\": \"Builds and maintains backend API.\",\n  \"is_active\": true\n}"
            },
            "url": "{{base_url}}/roles/"
          }
        },
        {
          "name": "Create technology",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Django REST Framework\",\n  \"slug\": \"django-rest-framework\",\n  \"category\": \"framework\",\n  \"description\": \"Framework for building Web APIs.\",\n  \"is_active\": true\n}"
            },
            "url": "{{base_url}}/technologies/"
          }
        }
      ]
    },
    {
      "name": "Negative cases",
      "item": [
        {
          "name": "Anonymous cannot create project",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Forbidden project\",\n  \"short_description\": \"Should fail.\",\n  \"description\": \"Anonymous write is forbidden.\",\n  \"goal\": \"Check permissions.\"\n}"
            },
            "url": "{{base_url}}/projects/"
          }
        },
        {
          "name": "Specialist cannot create vacancy in another project",
          "auth": {
            "type": "basic",
            "basic": [
              {
                "key": "username",
                "value": "{{specialist_username}}",
                "type": "string"
              },
              {
                "key": "password",
                "value": "{{specialist_password}}",
                "type": "string"
              }
            ]
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": {{role_id}},\n  \"title\": \"Forbidden vacancy\",\n  \"description\": \"Should be blocked by permissions.\",\n  \"required_level\": \"junior\",\n  \"required_count\": 1\n}"
            },
            "url": "{{base_url}}/projects/{{project_id}}/vacancies/"
          }
        },
        {
          "name": "Duplicate application should fail",
          "auth": {
            "type": "basic",
            "basic": [
              {
                "key": "username",
                "value": "{{specialist_username}}",
                "type": "string"
              },
              {
                "key": "password",
                "value": "{{specialist_password}}",
                "type": "string"
              }
            ]
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vacancy\": {{vacancy_id}},\n  \"message\": \"This should fail if an active application already exists.\"\n}"
            },
            "url": "{{base_url}}/applications/"
          }
        }
      ]
    }
  ]
}
